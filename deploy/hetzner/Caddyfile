(vracademy) {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    reverse_proxy app:7860
}

{$APP_DOMAIN} {
    import vracademy
}

http://{$SERVER_IP} {
    import vracademy
}

{$WWW_DOMAIN} {
    redir https://{$APP_DOMAIN}{uri} permanent
}
