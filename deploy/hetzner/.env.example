# DNS A record for this domain must point to the Hetzner server IP.
APP_DOMAIN=vracademy.io
WWW_DOMAIN=www.vracademy.io

# Use at least 16 characters with upper/lowercase letters, a number and a safe symbol such as !, _, -, . or @.
# Do not use semicolons because this value is embedded in a SQL Server connection string.
MSSQL_SA_PASSWORD=CHANGE_ME_StrongPassword_2026!
MSSQL_MEMORY_LIMIT_MB=2048

# Keep this false when importing the existing Azure database.
# For a completely fresh database, enable it only for the first deployment,
# set a strong password, sign in once, then set it back to false and redeploy.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_COMPANY=Ethernal
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=System
BOOTSTRAP_ADMIN_LAST_NAME=Administrator

# Optional Google login. Leave empty until OAuth is configured for the new domain.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional SMTP email notifications.
EMAIL_ENABLED=false
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_ENABLE_SSL=true
EMAIL_FROM_ADDRESS=office@nswebdevelopment.com
EMAIL_USERNAME=
EMAIL_PASSWORD=
